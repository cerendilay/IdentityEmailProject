@model ResetPasswordViewModel
@{
    Layout = "~/Views/Shared/_AuthLayout.cshtml";
    var invalidLink = ViewBag.InvalidLink == true;
}

<div class="form-head">
    <h1>Yeni Şifre Belirle</h1>
    <p>Hesabınız için yeni bir şifre belirleyin.</p>
</div>

@if (invalidLink)
{
    <div class="auth-alert err">Şifre yenileme bağlantısı geçersiz, daha önce kullanılmış veya süresi dolmuş.</div>
    <div class="auth-links">
        <a asp-controller="Password" asp-action="ForgotPassword">Yeni bağlantı iste</a>
        <a asp-controller="Login" asp-action="SignIn">Giriş sayfasına dön</a>
    </div>
}
else
{
    <div asp-validation-summary="All" class="auth-alert err" style="@(ViewData.ModelState.IsValid ? "display:none" : "")"></div>

    <form asp-controller="Password" asp-action="ResetPassword" method="post">
        <input type="hidden" asp-for="UserId" />
        <input type="hidden" asp-for="Token" />
        <div class="form-grid">
            <div class="field span-2">
                <label asp-for="Password">Yeni Şifre</label>
                <div class="input-wrap">
                    <i class="bi bi-lock lead"></i>
                    <input asp-for="Password" class="a-input" type="password" autocomplete="new-password" />
                </div>
            </div>
            <div class="field span-2">
                <label asp-for="PasswordConfirm">Yeni Şifre Tekrar</label>
                <div class="input-wrap">
                    <i class="bi bi-lock lead"></i>
                    <input asp-for="PasswordConfirm" class="a-input" type="password" autocomplete="new-password" />
                </div>
            </div>
        </div>

        <button type="submit" class="btn-primary-x"><span class="lbl">Şifreyi Güncelle</span> <i class="bi bi-check2"></i></button>
    </form>
}
