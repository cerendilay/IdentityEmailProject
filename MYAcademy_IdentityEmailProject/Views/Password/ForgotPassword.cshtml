@model ForgotPasswordViewModel
@{
    Layout = "~/Views/Shared/_AuthLayout.cshtml";
}

<div class="form-head">
    <h1>Şifremi Unuttum</h1>
    <p>Hesabınıza kayıtlı e-posta adresini girin, size şifre yenileme bağlantısı gönderelim.</p>
</div>

@if (TempData["Success"] != null)
{
    <div class="auth-alert ok">@TempData["Success"]</div>
}
<div asp-validation-summary="All" class="auth-alert err" style="@(ViewData.ModelState.IsValid ? "display:none" : "")"></div>

<form asp-controller="Password" asp-action="ForgotPassword" method="post">
    <div class="form-grid">
        <div class="field span-2">
            <label asp-for="Email">Email</label>
            <div class="input-wrap">
                <i class="bi bi-envelope lead"></i>
                <input asp-for="Email" class="a-input" type="email" placeholder="ornek@mail.com" />
            </div>
        </div>
    </div>

    <button type="submit" class="btn-primary-x"><span class="lbl">Bağlantı Gönder</span> <i class="bi bi-send"></i></button>
</form>

<div class="auth-links">
    <a asp-controller="Login" asp-action="SignIn">Giriş sayfasına dön</a>
</div>
