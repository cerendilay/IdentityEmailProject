@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>401 · Mailora</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
    <style>
        body { margin: 0; min-height: 100vh; display: grid; place-items: center; background: #F8F9FD; font-family: "Segoe UI", sans-serif; color: #303348; padding: 16px; }
        .err-card { background: #fff; border-radius: 20px; box-shadow: 0 10px 30px rgba(48, 51, 72, .08); padding: 48px 40px; text-align: center; max-width: 440px; width: 100%; }
        .err-ic { width: 88px; height: 88px; border-radius: 28px; margin: 0 auto 18px; background: linear-gradient(135deg, #EAE6FA, #E8F2FF); display: grid; place-items: center; color: #8B7FD6; font-size: 36px; }
        .err-code { font-size: 54px; font-weight: 800; color: #8B7FD6; line-height: 1; margin-bottom: 8px; }
        h1 { font-size: 22px; margin: 0 0 8px; }
        p { color: #85899B; margin: 0 0 24px; }
        a { display: inline-block; padding: 11px 20px; border-radius: 12px; background: #8B7FD6; color: #fff; text-decoration: none; font-weight: 600; margin: 4px; }
        a.soft { background: #EAE6FA; color: #7467C7; }
    </style>
</head>
<body>
    <div class="err-card">
        <div class="err-ic"><i class="bi bi-person-lock"></i></div>
        <div class="err-code">401</div>
        <h1>Oturum Gerekli</h1>
        <p>Bu sayfayı görüntülemek için giriş yapmalısınız.</p>
        <a href="/Login/SignIn">Giriş Yap</a>
    </div>
</body>
</html>
